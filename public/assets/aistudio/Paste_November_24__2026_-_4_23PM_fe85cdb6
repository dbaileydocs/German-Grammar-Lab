        for (const t of subOrderTemplates) {
          if (pool.length < 880) {
            const name = subNames[i % subNames.length];
            const prompt = i === 0
              ? `${t.main}, ${t.conj} ${t.mid} _____.`
              : `${name} schreibt: „${t.main}, ${t.conj} ${t.mid} _____.“`;
            pool.push({
              id: pool.length + 1,
              cat: `conjunctions`,
              rule: `Subordinate Clause Verb Position (${t.conj})`,
              prompt,
              answer: t.ans,
              options: [t.ans, ...t.wrong],
              en: t.en,
              why: t.why
            });
          }
        }
      }

      // C3. Subject-Verb Inversion & Position 2 / Fronted Subordinate Clause -> remaining 120 questions (880..999)
      const inversionDrills = [
        { p: `Am Montag _____ wir einen wichtigen Termin im Rathaus.`, ans: `haben`, opts: [`haben`, `wir haben`, `habt`, `hat`], en: `On Monday we have an important appointment at the town hall.`, why: `When a time expression ("Am Montag") takes Position 1, the finite verb ("haben") stays in Position 2 before the subject ("wir").` },
        { p: `Weil es heute stark regnet, _____ die Kinder im Wohnzimmer.`, ans: `spielen`, opts: [`spielen`, `die Kinder spielen`, `spielt`, `zu spielen`], en: `Because it is raining heavily today, the children are playing in the living room.`, why: `A fronted subordinate clause counts as Position 1, so the main clause must begin immediately with its finite verb ("spielen").` },
        { p: `Wenn du keine Zeit hast, _____ ich das Formular allein aus.`, ans: `fülle`, opts: [`fülle`, `ich fülle`, `füllt`, `füllen`], en: `If you have no time, I will fill in the form on my own.`, why: `After a fronted "Wenn" clause, the main clause starts directly with the conjugated verb ("fülle") followed by the subject ("ich").` },
        { p: `Morgen früh _____ mein Zug bereits um sechs Uhr.`, ans: `fährt`, opts: [`fährt`, `mein Zug fährt`, `fahren`, `abfahren`], en: `Tomorrow morning my train already departs at six o'clock.`, why: `Time adverbial in Position 1 triggers Subject–Verb inversion: verb ("fährt") in Position 2, subject ("mein Zug") in Position 3.` },
        { p: `Im Sommer _____ viele Familien gern an die Ostsee.`, ans: `fahren`, opts: [`fahren`, `viele Familien fahren`, `fährt`, `gefahren`], en: `In summer many families like travelling to the Baltic Sea.`, why: `With "Im Sommer" in Position 1, the plural verb "fahren" takes Position 2.` },
        { p: `Obwohl die Aufgabe schwer ist, _____ sie nicht auf.`, ans: `gibt`, opts: [`gibt`, `sie gibt`, `geben`, `abgibt`], en: `Although the task is difficult, she does not give up.`, why: `The fronted "Obwohl" clause fills Position 1, placing the conjugated stem "gibt" directly after the comma.` },
        { p: `Deswegen _____ wir uns lieber vorher telefonisch anmelden.`, ans: `sollten`, opts: [`sollten`, `wir sollten`, `sollte`, `sollt`], en: `Therefore we ought to register by telephone beforehand.`, why: `"Deswegen" occupies Position 1, so the modal verb "sollten" stands in Position 2.` },
        { p: `Nach der Arbeit _____ ich meistens noch schnell im Supermarkt ein.`, ans: `kaufe`, opts: [`kaufe`, `ich kaufe`, `kauft`, `einkaufe`], en: `After work I usually quickly do some shopping at the supermarket.`, why: `"Nach der Arbeit" sits in Position 1; the finite verb stem "kaufe" takes Position 2 and prefix "ein" closes the sentence.` },
        { p: `Glücklicherweise _____ alle Dokumente vollständig vorhanden.`, ans: `sind`, opts: [`sind`, `alle Dokumente sind`, `ist`, `seid`], en: `Fortunately all documents are present in full.`, why: `"Glücklicherweise" takes Position 1, keeping the verb "sind" in Position 2.` },
        { p: `Mit diesem Zug _____ Sie ohne Umsteigen direkt bis München.`, ans: `kommen`, opts: [`kommen`, `Sie kommen`, `kommt`, `kommst`], en: `With this train you get straight to Munich without changing.`, why: `Prepositional phrase in Position 1 triggers inversion: "kommen Sie".` },
        { p: `Als wir in Berlin ankamen, _____ es schon dunkel.`, ans: `war`, opts: [`war`, `es war`, `waren`, `ist`], en: `When we arrived in Berlin, it was already dark.`, why: `Fronted "Als" clause acts as Position 1, so the main clause starts with the verb "war".` },
        { p: `Im Wartezimmer _____ man nicht laut telefonieren.`, ans: `darf`, opts: [`darf`, `man darf`, `dürfen`, `darfst`], en: `In the waiting room one is not allowed to speak loudly on the phone.`, why: `Place expression in Position 1 puts modal "darf" in Position 2 ahead of "man".` }
      ];

      const timePrefixes = [
        ``,
        `Merksatz: `,
        `Im Büro: `,
        `Planung: `,
        `Alltag: `,
        `Praxis: `,
        `Hinweis: `,
        `Beispiel: `,
        `Unterwegs: `,
        `Wichtig: `
      ];
      for (let i = 0; pool.length < 1000; i++) {
        const inv = inversionDrills[i % inversionDrills.length];
        const tag = timePrefixes[Math.floor(i / inversionDrills.length) % timePrefixes.length];
        pool.push({
          id: pool.length + 1,
          cat: `conjunctions`,
          rule: `Position 2 & Subject–Verb Inversion`,
          prompt: tag ? `${tag}${inv.p}` : inv.p,
          answer: inv.ans,
          options: inv.opts,
          en: inv.en,
          why: inv.why
        });
      }

      return pool;
    }

    // =========================================================================
    // 2. APPLICATION STATE & SHIM PERSISTENCE
    // =========================================================================
    const QUESTION_POOL = buildQuestionPool();
    const CATEGORY_LABELS = {
      all: `All Categories`,
      prepositions: `Prepositions & Contractions`,
      separable: `Separable Verbs`,
      conjunctions: `Conjunctions & Word Order`
    };

    let appState = {
      filter: `all`,
      answeredIds: [],
      correctCount: 0,
      totalAnswered: 0,
      streak: 0,
      bestStreak: 0,
      activeRefTab: `prepositions`
    };

    let currentQuestion = null;
    let currentOptionsOrder = [];
    let hasAnsweredCurrent = false;

    function shuffleArray(arr) {
      const copy = arr.slice();
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const tmp = copy[i];
        copy[i] = copy[j];
        copy[j] = tmp;
      }
      return copy;
    }

    function getFilteredPool() {
      if (appState.filter === `all`) return QUESTION_POOL;
      return QUESTION_POOL.filter((q) => q.cat === appState.filter);
    }

    function getUnansweredInFilter() {
      const answeredSet = new Set(appState.answeredIds);
      return getFilteredPool().filter((q) => !answeredSet.has(q.id));
    }

    async function persistState() {
      if (window.notebookAppApi && typeof window.notebookAppApi.setAppState === `function`) {
        try {
          await window.notebookAppApi.setAppState({
            filter: appState.filter,
            answeredIds: appState.answeredIds,
            correctCount: appState.correctCount,
            totalAnswered: appState.totalAnswered,
            streak: appState.streak,
            bestStreak: appState.bestStreak,
            activeRefTab: appState.activeRefTab
          });
        } catch (err) {
          // Safe fallback if persistence rejects
        }
      }
    }

    function updateMetricsUI() {
      const filteredTotal = getFilteredPool().length;
      const unanswered = getUnansweredInFilter().length;
      const doneInFilter = filteredTotal - unanswered;
      const pct = filteredTotal > 0 ? Math.round((doneInFilter / filteredTotal) * 100) : 0;

      const elRemaining = document.getElementById(`stat-remaining`);
      const elRemainingSub = document.getElementById(`stat-remaining-sub`);
      const elAnswered = document.getElementById(`stat-answered`);
      const elCorrectCount = document.getElementById(`stat-correct-count`);
      const elAccuracy = document.getElementById(`stat-accuracy`);
      const elStreak = document.getElementById(`stat-streak`);
      const elBestStreak = document.getElementById(`stat-best-streak`);
      const elPoolStatus = document.getElementById(`pool-status-text`);
      const elPoolFill = document.getElementById(`pool-progress-fill`);
      const elPoolPct = document.getElementById(`pool-percent`);

      if (elRemaining) elRemaining.textContent = unanswered.toLocaleString(`en-GB`);
      if (elRemainingSub) elRemainingSub.textContent = `of ${filteredTotal.toLocaleString(`en-GB`)} in ${CATEGORY_LABELS[appState.filter]}`;
      if (elAnswered) elAnswered.textContent = appState.totalAnswered.toLocaleString(`en-GB`);
      if (elCorrectCount) elCorrectCount.textContent = `${appState.correctCount.toLocaleString(`en-GB`)} correct`;

      const acc = appState.totalAnswered > 0 ? `${Math.round((appState.correctCount / appState.totalAnswered) * 100)}%` : `—`;
      if (elAccuracy) elAccuracy.textContent = acc;
      if (elStreak) elStreak.textContent = String(appState.streak);
      if (elBestStreak) elBestStreak.textContent = `Best: ${appState.bestStreak}`;

      if (elPoolStatus) elPoolStatus.textContent = `${doneInFilter.toLocaleString(`en-GB`)} of ${filteredTotal.toLocaleString(`en-GB`)} answered · ${unanswered.toLocaleString(`en-GB`)} unseen`;
      if (elPoolFill) elPoolFill.style.width = `${pct}%`;
      if (elPoolPct) elPoolPct.textContent = `${pct}% complete`;

      // Update filter button counts (remaining unseen per category)
      const answeredSet = new Set(appState.answeredIds);
      const countAll = QUESTION_POOL.filter((q) => !answeredSet.has(q.id)).length;
      const countPrep = QUESTION_POOL.filter((q) => q.cat === `prepositions` && !answeredSet.has(q.id)).length;
      const countSep = QUESTION_POOL.filter((q) => q.cat === `separable` && !answeredSet.has(q.id)).length;
      const countConj = QUESTION_POOL.filter((q) => q.cat === `conjunctions` && !answeredSet.has(q.id)).length;

      const cAll = document.getElementById(`count-all`);
      const cPrep = document.getElementById(`count-prepositions`);
      const cSep = document.getElementById(`count-separable`);
      const cConj = document.getElementById(`count-conjunctions`);
      if (cAll) cAll.textContent = countAll.toLocaleString(`en-GB`);
      if (cPrep) cPrep.textContent = String(countPrep);
      if (cSep) cSep.textContent = String(countSep);
      if (cConj) cConj.textContent = String(countConj);

      // Update active filter buttons
      document.querySelectorAll(`.filter-btn`).forEach((btn) => {
        btn.classList.toggle(`is-active`, btn.dataset.filter === appState.filter);
      });
    }

    function renderPromptWithBlank(promptStr, filledText, statusClass) {
      const promptEl = document.getElementById(`question-prompt`);
      if (!promptEl) return;
      const parts = promptStr.split(`_____`);
      promptEl.textContent = ``;
      if (parts.length === 2) {
        promptEl.appendChild(document.createTextNode(parts[0]));
        const slot = document.createElement(`span`);
        slot.className = `blank-slot${statusClass ? ` ` + statusClass : ``}`;
        slot.textContent = filledText || `_____`;
        promptEl.appendChild(slot);
        promptEl.appendChild(document.createTextNode(parts[1]));
      } else {
        promptEl.textContent = promptStr;
      }
    }

    function loadNextQuestion() {
      const pool = getUnansweredInFilter();
      const activeArea = document.getElementById(`quiz-active-area`);
      const completionBox = document.getElementById(`completion-box`);

      if (pool.length === 0) {
        if (activeArea) activeArea.hidden = true;
        if (completionBox) {
          completionBox.hidden = false;
          const titleEl = document.getElementById(`completion-title`);
          const msgEl = document.getElementById(`completion-message`);
          if (titleEl) titleEl.textContent = `${CATEGORY_LABELS[appState.filter]} Complete`;
          if (msgEl) msgEl.textContent = `You have completed every unique question in ${CATEGORY_LABELS[appState.filter]} with zero repetitions.`;
        }
        updateMetricsUI();
        return;
      }

      if (activeArea) activeArea.hidden = false;
      if (completionBox) completionBox.hidden = true;

      const randomIdx = Math.floor(Math.random() * pool.length);
      currentQuestion = pool[randomIdx];
      currentOptionsOrder = shuffleArray(currentQuestion.options);
      hasAnsweredCurrent = false;

      const badgeEl = document.getElementById(`question-category-badge`);
      const idEl = document.getElementById(`question-id-label`);
      const gridEl = document.getElementById(`options-grid`);
      const feedbackEl = document.getElementById(`feedback-panel`);
      const nextBtn = document.getElementById(`next-btn`);

      if (badgeEl) badgeEl.textContent = CATEGORY_LABELS[currentQuestion.cat];
      if (idEl) idEl.textContent = `#${String(currentQuestion.id).padStart(4, `0`)}`;
      if (feedbackEl) {
        feedbackEl.hidden = true;
        feedbackEl.className = `feedback-panel`;
      }
      if (nextBtn) nextBtn.disabled = true;

      renderPromptWithBlank(currentQuestion.prompt, ``, ``);

      if (gridEl) {
        gridEl.textContent = ``;
        currentOptionsOrder.forEach((optText, i) => {
          const btn = document.createElement(`button`);
          btn.type = `button`;
          btn.className = `option-btn`;
          btn.dataset.option = optText;
          btn.onclick = function () { submitAnswer(optText); };

          const keySpan = document.createElement(`span`);
          keySpan.className = `option-key`;
          keySpan.textContent = String(i + 1);

          const textSpan = document.createElement(`span`);
          textSpan.className = `option-text`;
          textSpan.textContent = optText;

          btn.appendChild(keySpan);
          btn.appendChild(textSpan);
          gridEl.appendChild(btn);
        });
      }

      updateMetricsUI();
    }

    function submitAnswer(chosenOption) {
      if (hasAnsweredCurrent || !currentQuestion) return;
      hasAnsweredCurrent = true;

      const isCorrect = chosenOption === currentQuestion.answer;

      // Record answered ID without duplicates so questions never repeat
      if (!appState.answeredIds.includes(currentQuestion.id)) {
        appState.answeredIds.push(currentQuestion.id);
      }
      appState.totalAnswered += 1;
      if (isCorrect) {
        appState.correctCount += 1;
        appState.streak += 1;
        if (appState.streak > appState.bestStreak) appState.bestStreak = appState.streak;
      } else {
        appState.streak = 0;
      }

      // Highlight prompt blank and buttons
      renderPromptWithBlank(
        currentQuestion.prompt,
        currentQuestion.answer,
        isCorrect ? `is-correct` : `is-wrong`
      );

      document.querySelectorAll(`.option-btn`).forEach((btn) => {
        btn.disabled = true;
        if (btn.dataset.option === currentQuestion.answer) {
          btn.classList.add(`is-correct`);
        } else if (btn.dataset.option === chosenOption && !isCorrect) {
          btn.classList.add(`is-wrong`);
        }
      });

      const feedbackEl = document.getElementById(`feedback-panel`);
      const statusEl = document.getElementById(`feedback-status`);
      const ruleEl = document.getElementById(`feedback-rule-tag`);
      const transEl = document.getElementById(`feedback-translation`);
      const expEl = document.getElementById(`feedback-explanation`);
      const nextBtn = document.getElementById(`next-btn`);

      if (feedbackEl) {
        feedbackEl.hidden = false;
        feedbackEl.className = `feedback-panel ${isCorrect ? `is-correct` : `is-wrong`}`;
      }
      if (statusEl) statusEl.textContent = isCorrect ? `Correct` : `Incorrect — Answer: ${currentQuestion.answer}`;
      if (ruleEl) ruleEl.textContent = currentQuestion.rule;
      if (transEl) transEl.textContent = `“${currentQuestion.en}”`;
      if (expEl) expEl.textContent = currentQuestion.why;
      if (nextBtn) nextBtn.disabled = false;

      updateMetricsUI();
      persistState();
    }

    function setCategoryFilter(filterKey) {
      appState.filter = filterKey;
      persistState();
      loadNextQuestion();
    }

    function handleResetClick(btn) {
      if (!btn) return;
      if (btn.dataset.armed !== `true`) {
        btn.dataset.armed = `true`;
        const span = btn.querySelector(`span`);
        if (span) span.textContent = `Confirm Reset?`;
        setTimeout(() => {
          if (btn.dataset.armed === `true`) {
            btn.dataset.armed = `false`;
            const s = btn.querySelector(`span`);
            if (s) s.textContent = `Reset Session`;
          }
        }, 3500);
        return;
      }
      btn.dataset.armed = `false`;
      const span = btn.querySelector(`span`);
      if (span) span.textContent = `Reset Session`;

      appState.answeredIds = [];
      appState.correctCount = 0;
      appState.totalAnswered = 0;
      appState.streak = 0;
      appState.bestStreak = 0;
      persistState();
      loadNextQuestion();
    }

    function resetCategoryProgress() {
      const catIds = new Set(getFilteredPool().map((q) => q.id));
      appState.answeredIds = appState.answeredIds.filter((id) => !catIds.has(id));
      persistState();
      loadNextQuestion();
    }

    function switchRefTab(tabKey) {
      appState.activeRefTab = tabKey;
      const keys = [`prepositions`, `separable`, `conjunctions`];
      keys.forEach((k) => {
        const tab = document.getElementById(`reftab-${k}`);
        const panel = document.getElementById(`refpanel-${k}`);
        const isActive = k === tabKey;
        if (tab) {
          tab.classList.toggle(`is-active`, isActive);
          tab.setAttribute(`aria-selected`, String(isActive));
        }
        if (panel) panel.hidden = !isActive;
      });
      persistState();
    }

    // Keyboard support: 1-4 to pick options, Enter for Next Question
    document.addEventListener(`keydown`, function (e) {
      if (e.target && (e.target.tagName === `INPUT` || e.target.tagName === `TEXTAREA`)) return;
      if (!hasAnsweredCurrent && [`1`, `2`, `3`, `4`].includes(e.key)) {
        const idx = Number(e.key) - 1;
        if (currentOptionsOrder[idx]) {
          e.preventDefault();
          submitAnswer(currentOptionsOrder[idx]);
        }
      } else if (hasAnsweredCurrent && e.key === `Enter`) {
        e.preventDefault();
        loadNextQuestion();
      }
    });

    async function initApp() {
      if (window.lucide && typeof window.lucide.createIcons === `function`) {
        window.lucide.createIcons();
      }

      if (window.notebookAppApi && typeof window.notebookAppApi.getAppState === `function`) {
        try {
          const saved = await window.notebookAppApi.getAppState();
          if (saved && typeof saved === `object`) {
            if (saved.filter && CATEGORY_LABELS[saved.filter]) appState.filter = saved.filter;
            if (Array.isArray(saved.answeredIds)) appState.answeredIds = saved.answeredIds;
            if (typeof saved.correctCount === `number`) appState.correctCount = saved.correctCount;
            if (typeof saved.totalAnswered === `number`) appState.totalAnswered = saved.totalAnswered;
            if (typeof saved.streak === `number`) appState.streak = saved.streak;
            if (typeof saved.bestStreak === `number`) appState.bestStreak = saved.bestStreak;
            if (saved.activeRefTab) appState.activeRefTab = saved.activeRefTab;
          }
        } catch (err) {
          // Ignore corrupted state
        }
      }

      switchRefTab(appState.activeRefTab);
      loadNextQuestion();

      if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === `function`) {
        window.notebookAppApi.notifyAppReady();
      }
    }

    document.addEventListener(`DOMContentLoaded`, initApp);
  </script>
</body>
